<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nightly backup of the hub database. Placeholders __HOME__ / __USER__ are substituted
  by scripts/sync-deploy.sh from what the MINI reports.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ryandiv.promptflow-sync-backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/PromptFlow-Sync/sync-backup.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/opt/homebrew/var/log/promptflow-sync-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/opt/homebrew/var/log/promptflow-sync-backup.log</string>
</dict>
</plist>
