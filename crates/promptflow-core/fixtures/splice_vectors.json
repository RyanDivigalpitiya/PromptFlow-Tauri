{
  "version": 1,
  "cases": [
    {
      "name": "insert before a run shifts it",
      "ranges": [
        2,
        2
      ],
      "oldLength": 6,
      "location": 0,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        4,
        2
      ]
    },
    {
      "name": "insert strictly inside a run extends it",
      "ranges": [
        1,
        3
      ],
      "oldLength": 5,
      "location": 2,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        1,
        5
      ]
    },
    {
      "name": "replace inside a run keeps its length",
      "ranges": [
        1,
        3
      ],
      "oldLength": 5,
      "location": 2,
      "length": 1,
      "replacementLength": 1,
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "insert at a run's leading edge does not inherit",
      "ranges": [
        1,
        3
      ],
      "oldLength": 5,
      "location": 1,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        3,
        3
      ]
    },
    {
      "name": "insert at a run's trailing edge does not inherit",
      "ranges": [
        1,
        3
      ],
      "oldLength": 5,
      "location": 4,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "insert at the very end of the text never inherits",
      "ranges": [
        0,
        5
      ],
      "oldLength": 5,
      "location": 5,
      "length": 0,
      "replacementLength": 3,
      "expected": [
        0,
        5
      ]
    },
    {
      "name": "deleting a whole run removes it",
      "ranges": [
        2,
        2
      ],
      "oldLength": 6,
      "location": 2,
      "length": 2,
      "replacementLength": 0,
      "expected": []
    },
    {
      "name": "deleting half a run clips it",
      "ranges": [
        2,
        2
      ],
      "oldLength": 6,
      "location": 2,
      "length": 1,
      "replacementLength": 0,
      "expected": [
        2,
        1
      ]
    },
    {
      "name": "deleting between two runs fuses them",
      "ranges": [
        0,
        2,
        4,
        2
      ],
      "oldLength": 6,
      "location": 2,
      "length": 2,
      "replacementLength": 0,
      "expected": [
        0,
        4
      ]
    },
    {
      "name": "two runs shift independently",
      "ranges": [
        0,
        1,
        3,
        1
      ],
      "oldLength": 5,
      "location": 2,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        0,
        1,
        5,
        1
      ]
    },
    {
      "name": "a replacement longer than what it replaces",
      "ranges": [
        0,
        6
      ],
      "oldLength": 6,
      "location": 2,
      "length": 2,
      "replacementLength": 5,
      "expected": [
        0,
        9
      ]
    },
    {
      "name": "deleting the whole text clears every run",
      "ranges": [
        0,
        6
      ],
      "oldLength": 6,
      "location": 0,
      "length": 6,
      "replacementLength": 0,
      "expected": []
    },
    {
      "name": "an empty range list stays empty",
      "ranges": [],
      "oldLength": 5,
      "location": 1,
      "length": 1,
      "replacementLength": 3,
      "expected": []
    },
    {
      "name": "out-of-bounds ranges are clamped, not trusted",
      "ranges": [
        10,
        5
      ],
      "oldLength": 3,
      "location": 0,
      "length": 0,
      "replacementLength": 1,
      "expected": []
    },
    {
      "name": "an edit past the end of the text is clamped",
      "ranges": [
        0,
        2
      ],
      "oldLength": 3,
      "location": 99,
      "length": 99,
      "replacementLength": 1,
      "expected": [
        0,
        2
      ]
    },
    {
      "name": "a run that starts at 0 and an insert at 0",
      "ranges": [
        0,
        3
      ],
      "oldLength": 5,
      "location": 0,
      "length": 0,
      "replacementLength": 2,
      "expected": [
        2,
        3
      ]
    }
  ]
}
